# ============================================================
# PSC-Master Optimized .gitignore
# ============================================================

# ---------- Android / Gradle ----------
.gradle/
build/
/*/build/
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aar
*.bundle

# ---------- IDE Specific (Android Studio / IntelliJ / VS Code) ----------
.idea/
*.iml
.idea/modules.xml
.idea/workspace.xml
.idea/tasks.xml
.idea/assetWizardSettings.xml
.idea/navEditor.xml
.idea/caches/
.kotlin/
.vscode/

# ---------- Secrets & Credentials (CRITICAL) ----------
local.properties
/app/google-services.json
/app/google-services*.json
secrets.properties
*.jks
*.keystore
keystore.properties

# ---------- OS-specific ----------
.DS_Store
Thumbs.db
*.swp
*~
executable.stackdump

# ---------- Misc / Analysis ----------
*.hprof
*.pyc
*.log
.navigation/

# ---------- Gradle Wrapper (Optional) ----------
# Some prefer to keep this, but if you want a clean repo:
# !gradle/wrapper/gradle-wrapper.jar
# !gradle/wrapper/gradle-wrapper.properties